# Written by chainmail bootstrap. Edits are kept for config.toml only.
[Unit]
Description=chainmail policy daemon
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/libexec/chainmail/chainmail daemon --config /etc/chainmail/config.toml --state-dir /var/lib/chainmail --vault-key-file /etc/chainmail/vault-key
User=chainmail
Group=chainmail
SupplementaryGroups=chainmail-clients
StateDirectory=chainmail
StateDirectoryMode=0700
RuntimeDirectory=chainmail
RuntimeDirectoryMode=0755
UMask=0077
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=2
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

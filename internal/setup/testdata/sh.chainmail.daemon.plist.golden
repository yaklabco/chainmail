<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by chainmail bootstrap. Edits are kept for config.toml only. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sh.chainmail.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/chainmail/bin/chainmail</string>
    <string>daemon</string>
    <string>--config</string>
    <string>/etc/chainmail/config.toml</string>
    <string>--state-dir</string>
    <string>/var/lib/chainmail</string>
    <string>--vault-key-file</string>
    <string>/etc/chainmail/vault-key</string>
  </array>
  <key>UserName</key>
  <string>_chainmail</string>
  <key>GroupName</key>
  <string>chainmail-clients</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardErrorPath</key>
  <string>/var/log/chainmail/daemon.log</string>
</dict>
</plist>

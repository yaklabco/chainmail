              "account",
              "folders"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "partial": {
          "description": "accounts or folders that could not be read; the rest is valid",
          "items": {
            "additionalProperties": false,
            "properties": {
              "account": {
                "type": "string"
              },
              "folder": {

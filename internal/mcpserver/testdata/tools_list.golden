                        "type": "string"
                      }
                    },
                    "required": [
                      "untrusted"
                    ],
                    "type": "object"
                  },
                  "from": {
                    "description": "senders as Name \u003caddress\u003e",
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "untrusted": {
                          "type": "string"
                        }
                      },
                      "required": [

                    "type": "string"
                  }
                },
                "required": [
                  "untrusted"
                ],
                "type": "object"
              },
              "from": {
                "description": "senders as Name \u003caddress\u003e",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "untrusted": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "untrusted"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "has_attachment": {
                "type": "boolean"
              },
              "keywords": {
                "description": "every other flag, such as $Forwarded, as the server has it; untrusted, since a server or a sender's client chose it",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "untrusted": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "untrusted"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",

      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "account": {
                "type": "string"
              },
              "folders": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "messages": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "name": {
                      "additionalProperties": false,
                      "description": "the folder name the other tools take, as the server names it",
                      "properties": {
                        "untrusted": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "untrusted"
                      ],
                      "type": "object"
                    },

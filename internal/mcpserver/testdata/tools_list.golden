                      "type": "string"
                    },
                    "unseen": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "name",
                    "role",
                    "messages",
                    "unseen"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              }
            },
            "required": [
              "account",
              "folders"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "partial": {
          "description": "accounts or folders that could not be read; the rest is valid",
          "items": {
            "additionalProperties": false,
            "properties": {

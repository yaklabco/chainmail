                ]
              },
              "kind": {
                "description": "new, flags, expunged, status, gap, item, item_mail, rule, item_due_soon, item_due, item_overdue, invite, event_changed, event_cancelled or invite_reply",
                "type": "string"
              },
              "labels": {

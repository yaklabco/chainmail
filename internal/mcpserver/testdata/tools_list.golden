            },
            "updated_at": {
              "description": "in RFC 3339",
              "type": "string"
            },
            "updated_by": {
              "description": "\u003cuid\u003e/\u003cclient kind\u003e",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "accounts",
            "query",
            "on_new",
            "priority",
            "stop",
            "actions",
            "max_per_run",
            "enabled",
            "revision",
            "created_at",
            "updated_at",

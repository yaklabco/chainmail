      "properties": {
        "cascade": {
          "description": "also delete every live item below it; needed when it has live children",
          "type": "boolean"
        },
        "id": {
          "description": "the item to delete",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "delete_item",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {

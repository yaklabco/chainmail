  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Reply to a message"
    },
    "description": "Reply to a message, quoting it under the new text. With all, it replies to everyone. With draft, nothing is sent and each call saves a new draft. Policy may hold a send: then status is held, the message was NOT sent, it was saved to the account's Drafts for James, and it must not be retried. Repeating the same send within 7 days replays the first result instead of sending twice.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "description": "reply to everyone: add the original To and Cc, less this account's own address",
          "type": "boolean"
        },
        "attachments": {
          "description": "absolute paths of files to attach, in order",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "bcc": {
          "description": "blind-copied recipients",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "body": {
          "description": "the new text, Markdown unless body_format says otherwise",
          "type": "string"
        },
        "body_format": {
          "description": "markdown (the default), text or html",
          "type": "string"
        },
        "cc": {
          "description": "more copied recipients",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "draft": {
          "description": "save the reply to Drafts instead of sending it",
          "type": "boolean"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "extra headers: Reply-To and X- headers only",
          "type": "object"
        },
        "html_text": {
          "description": "with body_format html: the plain-text part; empty means derived from the HTML",
          "type": "string"
        },
        "idempotency_key": {
          "description": "as in send_email",
          "type": "string"
        },
        "inline": {
          "description": "images the body shows inline",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "how the body refers to the image, as in ![chart](chart.png)",
                "type": "string"
              },
              "path": {
                "description": "absolute path of the image file",
                "type": "string"
              }
            },
            "required": [
              "name",
              "path"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "no_signature": {
          "description": "leave out the account's configured signature",
          "type": "boolean"
        },
        "ref": {
          "description": "the message to reply to",
          "type": "string"
        },
        "to": {
          "description": "more recipients, added to the ones the reply goes to",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "name": "reply",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "description": "with held, always present: recipients not on the allowlist, possibly taken from the original message",
          "items": {
            "additionalProperties": false,
            "properties": {
              "untrusted": {
                "type": "string"
              }
            },
            "required": [
              "untrusted"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "draft_ref": {
          "description": "the ref of the saved draft; with held always present, empty when the server did not report it",
          "type": "string"
        },
        "hint": {
          "description": "what to tell James, or how to find the draft",
          "type": "string"
        },
        "idempotency_key": {
          "description": "the key this call used",
          "type": "string"
        },
        "message_id": {
          "additionalProperties": false,
          "description": "the Message-ID, without angle brackets; untrusted, since send_draft keeps the stored draft's own",
          "properties": {
            "untrusted": {
              "type": "string"
            }
          },
          "required": [
            "untrusted"
          ],
          "type": [
            "null",
            "object"
          ]
        },
        "original_status": {
          "description": "with duplicate: what the first call with this key did",
          "type": "string"
        },
        "sent_copy_error": {
          "description": "why the Sent copy could not be stored; the message itself was sent",
          "type": "string"
        },
        "sent_ref": {
          "description": "the ref of the copy in Sent",
          "type": "string"
        },
        "status": {
          "description": "sent, draft, held or duplicate",
          "type": "string"
        },
        "too_many_recipients": {
          "description": "with held, always present: more recipients than policy allows",
          "type": "boolean"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "title": "Reply to a message"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Restore a work item"
    },
    "description": "Restore a soft-deleted work item. With cascade it also restores the items below it that the same delete removed. An item whose parent is still deleted cannot be restored: restore the parent first.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cascade": {
          "description": "also restore the items below it that the same delete removed",
          "type": "boolean"
        },

        },
        "cursor": {
          "description": "next_cursor from the previous page of the same search",
          "type": "string"
        },
        "limit": {
          "description": "rows per page, 1 to 200; default 25",
          "type": "integer"
        },
        "query": {
          "description": "a Gmail-style query such as invoice from:acme newer_than:30d; empty matches every message",
          "type": "string"
        },
        "snippets": {
          "description": "add a snippet of up to 200 characters to each row",
          "type": "boolean"
        },
        "threads": {
          "description": "collapse rows to the newest message of each thread",
          "type": "boolean"
        }
      },
      "type": "object"
    },

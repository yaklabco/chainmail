      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "account": {
                "type": "string"
              },
              "folders": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "messages": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "name": {
                      "additionalProperties": false,
                      "description": "the folder name the other tools take, as the server names it",
                      "properties": {
                        "untrusted": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "untrusted"
                      ],
                      "type": "object"
                    },
                    "role": {
                      "description": "inbox, sent, drafts, archive, trash, spam, all or none",
                      "type": "string"
                    },
                    "unseen": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "name",
                    "role",
                    "messages",
                    "unseen"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              }
            },
            "required": [
              "account",
              "folders"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "partial": {
          "description": "accounts or folders that could not be read; the rest is valid",
          "items": {
            "additionalProperties": false,
            "properties": {
              "account": {
                "type": "string"
              },
              "folder": {
                "additionalProperties": false,
                "description": "absent when the whole account failed",
                "properties": {
                  "untrusted": {

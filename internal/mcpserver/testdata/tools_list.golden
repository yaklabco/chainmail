                "properties": {
                  "account": {
                    "type": "string"
                  },
                  "date": {
                    "description": "the Date header, or the arrival time, in RFC 3339",
                    "type": "string"
                  },
                  "flags": {
                    "description": "system flags by short name: seen, flagged, answered, draft, deleted",
                    "items": {
                      "type": "string"
                    },
                    "type": [
                      "null",
                      "array"
                    ]
                  },
                  "folder": {
                    "additionalProperties": false,
                    "properties": {
                      "untrusted": {
                        "type": "string"
                      }
                    },
                    "required": [

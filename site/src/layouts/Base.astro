---
// The page shell: <head>, the nav, the closing footer and the kit's scripts.
// The kit is served as plain files from /kit/ (public/kit), because it loads
// its own modules, effects and moments at run time by URL.
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = 'https://chainmail.sh/';
const card = 'https://chainmail.sh/img/social-card.png';
const cardAlt = 'chainmail: let AI agents handle your email';
// The nav and footer link to the home page's sections: same-page anchors on
// the home page, /#section from any other page.
const home = ['/', '/index', '/index.html'].includes(Astro.url.pathname) ? '' : '/';
---
<!doctype html>
<html lang="en" data-type="software" data-radius="sharp" data-ground="sage" data-buttons="solid" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="chainmail">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={card}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={cardAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={card}>
<meta name="twitter:image:alt" content={cardAlt}>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/img/favicon-192.png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<link rel="stylesheet" href="/kit/system.css">
<link rel="stylesheet" href="/kit/ui/cards.css">
<link rel="stylesheet" href="/kit/motion/motion.css">
<link rel="stylesheet" href="/kit/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/kit/layout/layout.css">
<link rel="stylesheet" href="/kit/icons/icon.css">
<link rel="stylesheet" href="/kit/ui/base.css">
<link rel="stylesheet" href="/kit/diagrams/diagram.css">
<script is:inline src="/kit/backgrounds/backgrounds.js"></script>
<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/kit/moments/moments.js">
<link rel="modulepreload" href="/kit/moments/lib.js">
<link rel="modulepreload" href="/kit/moments/iris-opens/moment.js">
<link rel="modulepreload" href="/kit/moments/counter-rolls/moment.js">
</head>
<body>

<header class="nav">
  <div class="wrap nav__bar">
    <a class="nav__logo" href={`${home}#top`}><img class="nav__wordmark" src="/img/wordmark-dark.svg" width="166" height="22" alt="chainmail"></a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item">
        <a class="nav__link" href={`${home}#agents`}>Agents <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-3">
              <p class="t-label">Connect</p>
              <a href={`${home}#agents`}>Claude Code<span>chainmail mcp over stdio</span></a>
              <a href={`${home}#agents`}>Codex and Cursor<span>Any stdio MCP client</span></a>
              <a href="/docs/reference/mcp-tools">MCP tools<span>38 tools, gated by policy</span></a>
            </div>
            <div class="menu-col span-3">
              <p class="t-label">Mail</p>
              <a href={`${home}#search`}>Search<span>One query, every account</span></a>
              <a href={`${home}#features`}>Watch<span>Events a watcher resumes</span></a>
              <a href={`${home}#features`}>Work items<span>Mail filed against tasks</span></a>
            </div>
            <a class="menu-card span-3 start-10" href="https://github.com/yaklabco/chainmail/releases/tag/v0.1.0">
              <div class="panel">
                <div class="stage stage--fade-br"><div class="at-corner" style="--ax:24px;--ay:24px;width:340px">
                  <div class="ui ui-panel cm-win" aria-hidden="true">
                    <div class="cm-cmd"><span class="p">$ </span>brew install yaklabco/tap/chainmail<br><span class="p">$ </span>chainmail version</div>
                  </div>
                </div></div>
              </div>
              <span class="t-card">v0.1.0 is out</span>
              <span class="t-small muted">Released 7 November 2026</span>
            </a>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href={`${home}#policy`}>Policy</a></div>
      <div class="nav__item"><a class="nav__link" href={`${home}#search`}>Search</a></div>
      <div class="nav__item"><a class="nav__link" href={`${home}#install`}>Install</a></div>
      <div class="nav__item"><a class="nav__link" href="/docs/">Docs</a></div>
    </nav>
    <div class="nav__actions">
      <a class="nav__link" href="https://github.com/yaklabco/chainmail">GitHub</a>
      <a class="btn btn--primary" href={`${home}#install`}>Get chainmail</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<slot />

<footer class="footer closing footer--statement g2m" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head--split">
        <div><h2 id="close-h">Install chainmail in one command</h2><p class="t-lead">Free and open source. Version 0.1.0.</p></div>
        <div class="close__cta-end">
          <a class="btn btn--primary" href={`${home}#install`}>Get chainmail</a>
        </div>
      </div>
      <p class="close__word" aria-hidden="true">chainmail</p>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-6 stack-4">
          <p class="footer__lede">Email for AI agents, without your passwords.</p>
        </div>
        <div class="span-2 footer__col"><h3>Product</h3><ul><li><a href={`${home}#agents`}>Agents</a></li><li><a href={`${home}#policy`}>Policy</a></li><li><a href={`${home}#search`}>Search</a></li><li><a href={`${home}#install`}>Install</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Docs</h3><ul><li><a href="/docs/getting-started/quick-start">Quick start</a></li><li><a href="/docs/concepts/policy">Send policy</a></li><li><a href="/docs/reference/mcp-tools">MCP tools</a></li><li><a href="/docs/reference/commands/chainmail">Commands</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Project</h3><ul><li><a href="https://github.com/yaklabco/chainmail">GitHub</a></li><li><a href="https://github.com/yaklabco/chainmail/releases">Releases</a></li><li><a href="/docs/reference/changelog">Changelog</a></li><li><a href="https://github.com/yaklabco/chainmail/blob/main/LICENSE">Licence</a></li></ul></div>
      </div>
      <div class="footer__legal">
        <span>chainmail &nbsp; &copy; 2026 James Ainslie, MIT licence</span>
        <span class="credits">Product names and logos are trademarks of their owners.</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline type="module" src="/kit/system.js"></script>
<script is:inline type="module" src="/kit/motion/motion.js"></script>
<script is:inline type="module" src="/kit/layout/layout.js"></script>
<script is:inline type="module" src="/kit/diagrams/mount.js"></script>
</body>
</html>

---
import Base from '../layouts/Base.astro';
import bench from '../data/search-bench.json';

// The chart reads the benchmark rows: each bar is a share of the slowest server time.
const max = Math.max(...bench.rows.map((r) => r.server_ms));
const secs = (ms: number) => (ms >= 1000 ? `${(ms / 1000).toFixed(2)} s` : `${Math.round(ms)} ms`);
const rows = bench.rows.map((r) => ({
  ...r,
  server: secs(r.server_ms),
  cache: secs(r.cache_ms),
  factor: `${Math.round(r.server_ms / r.cache_ms)}x`,
  serverPct: (r.server_ms / max) * 100,
  cachePct: (r.cache_ms / max) * 100,
}));
---
<Base title="chainmail search: every inbox in milliseconds" description="One Gmail-style query searches all your mail accounts from a local index. The newest 50 messages across four accounts take 88 ms, against 2.8 s from the mail servers.">
<main id="top">
  <section class="hero hero--collage" aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text grid hero__grid">
      <div class="hero__text span-6">
        <p class="hero-notice"><a class="link" href="/docs/concepts/cache">How the local cache works</a></p>
        <h1 id="hero-h">Search every inbox in milliseconds</h1>
        <p class="hero__lead">One Gmail-style query covers all your accounts, and chainmail answers it from a local index. The newest 50 messages across four accounts take 88 ms. The mail servers take 2.8 s.</p>
        <div class="btn-row"><a class="btn btn--primary" href="/#install">Get chainmail</a><a class="btn btn--secondary" href="/docs/guide/reading-and-searching">Read the query syntax</a></div>
      </div>
      <div class="hero__art span-6 start-7" role="img" aria-label="hyperfine runs the same search ten times against the mail servers and ten times against the local index. The servers average 2.796 seconds and the index 87.9 milliseconds, 31.8 times faster." data-ly-steps="900" data-ly-hold="2600" data-ui-pause-host>
        <div class="ly-piece ly-piece--main ui ui-panel cm-win" aria-hidden="true">
          <div class="cm-bar"><span class="ui-dots"><i></i><i></i><i></i></span><span class="cm-bar__title"><b>hyperfine</b> · ~/mail</span><span class="ui-spacer"></span><span class="cm-tag">4 accounts</span></div>
          <div class="cm-term__body cm-hf">
            <div class="cm-user"><span>$</span><span>hyperfine --runs 10 'chainmail search --limit 50 --source server' 'chainmail search --limit 50 --source cache'</span></div>
            <div class="cm-hf__b" data-step>
              <div><b>Benchmark 1:</b> chainmail search --limit 50 --source server</div>
              <div class="k">&nbsp;&nbsp;Time (mean ± σ): <span class="v">2.796 s</span> ± 0.637 s</div>
              <div class="k">&nbsp;&nbsp;Range (min … max): 1.889 s … 3.709 s &nbsp;&nbsp;10 runs</div>
            </div>
            <div class="cm-hf__b" data-step>
              <div><b>Benchmark 2:</b> chainmail search --limit 50 --source cache</div>
              <div class="k">&nbsp;&nbsp;Time (mean ± σ): <span class="v gold">87.9 ms</span> ± 2.8 ms</div>
              <div class="k">&nbsp;&nbsp;Range (min … max): 83.7 ms … 92.8 ms &nbsp;&nbsp;10 runs</div>
            </div>
            <div class="cm-res cm-held" data-step><span><b>Summary</b><br>--source cache ran <span class="gold">31.80 ± 7.31</span> times faster than --source server</span></div>
            <div class="cm-user" data-step><span>$</span><span>hyperfine --runs 10 'chainmail search invoice newer_than:30d --source server' '... --source cache'</span></div>
            <div class="cm-res cm-held" data-step><span><b>Summary</b><br>--source cache ran <span class="gold">71.27 ± 25.77</span> times faster than --source server</span></div>
          </div>
        </div>
      </div>
    </div></div>
  </section>

  <section class="section" id="numbers" aria-labelledby="numbers-h">
    <div class="wrap">
      <div class="grid">
        <h2 id="numbers-h" class="span-6">Measured on four real accounts</h2>
        <p class="span-6 start-7 t-lead">hyperfine ran each search ten times on 5 November 2026, against four accounts with up to 256,000 messages each. The server bars are the same daemon with <code>--source server</code>, so both paths share the network and the servers.</p>
      </div>
      <div class="cm-chart">
        <div class="cm-chart__legend" aria-hidden="true"><span class="sw sw--server"></span>From the mail servers<span class="sw sw--cache"></span>From the local index</div>
        <table>
          <caption class="sr-only">Mean time for each operation, from the mail servers and from the local index</caption>
          <thead><tr><th scope="col">Operation</th><th scope="col">Time</th><th scope="col">Faster</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr title={`${r.label}: ${r.server} from the servers, ${r.cache} from the index`}>
                <th scope="row"><span class="l">{r.label}</span><span class="q">{r.query}</span></th>
                <td>
                  <span class="bar bar--server" style={`--w:${r.serverPct.toFixed(2)}%`}><span class="sr-only">Servers </span><i>{r.server}</i></span>
                  <span class="bar bar--cache" style={`--w:${r.cachePct.toFixed(2)}%`}><span class="sr-only">Index </span><i>{r.cache}</i></span>
                </td>
                <td class="f">{r.factor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cm-chart__note t-small muted">Opening a message or a thread is compared with three timed runs of the release before the index.</p>
    </div>
  </section>

  <section class="section" id="syntax" aria-labelledby="syntax-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-6 stack-5">
          <h2 id="syntax-h">One query language on every account</h2>
          <p class="t-lead">Gmail's operators work on iCloud and any IMAP account as well as on Google. A plain IMAP server refuses <code>has:attachment</code>, <code>filename:</code> and <code>label:</code>, and the index answers them.</p>
          <ul class="cm-facts stack-2">
            <li><code>OR</code>, <code>-</code> and parentheses combine any of them.</li>
            <li><code>item:</code> finds the mail filed under a task.</li>
            <li>Every answer says whether the index or the server gave it, for each account and each message.</li>
          </ul>
          <p><a class="link" href="/docs/guide/reading-and-searching">Read the query syntax</a></p>
        </div>
        <div class="frame frame--split span-6 start-7" data-visual data-fx="grain-gradient" data-fx-seed="2207" data-fx-params='{"speed":0,"grainMotion":0,"calm":0.6,"calmX":0.4,"calmY":0.4,"softness":0.6}' role="img" aria-label="A search for PDF attachments from Northfield Library or Marta Silva finds five messages on the icloud and personal accounts. Each account was answered from the cache.">
          <div class="stage stage--fade-b">
            <div class="at-corner to-edge" style="--ax:56px;--ay:56px;width:640px">
              <div class="ui ui-panel cm-win" aria-hidden="true">
                <div class="cm-bar"><span class="ui-dots"><i></i><i></i><i></i></span><span class="cm-bar__title"><b>chainmail</b> · search</span></div>
                <div class="cm-cmd"><span class="p">$ </span>chainmail search <s>'has:attachment filename:pdf from:(northfield OR silva)'</s>
                  <div class="cm-cmd__sum"><span>5 messages</span><span>·</span><span>icloud, personal</span><span class="cm-tag">source: cache</span></div>
                </div>
                <div class="cm-rows">
                  <div class="cm-row"><span class="cm-row__acct">personal</span><span class="cm-row__from">Marta Silva</span><span class="cm-row__age">11d</span><span class="cm-row__subj">Lease renewal for the flat · lease-2027.pdf</span></div>
                  <div class="cm-row"><span class="cm-row__acct">icloud</span><span class="cm-row__from">Northfield Library</span><span class="cm-row__age">8d</span><span class="cm-row__subj">Your loan renewal is due · notice.pdf</span></div>
                  <div class="cm-row"><span class="cm-row__acct">personal</span><span class="cm-row__from">Marta Silva</span><span class="cm-row__age">2mo</span><span class="cm-row__subj">Inventory for the flat · inventory.pdf</span></div>
                  <div class="cm-row"><span class="cm-row__acct">icloud</span><span class="cm-row__from">Northfield Library</span><span class="cm-row__age">5mo</span><span class="cm-row__subj">Summer reading list · list.pdf</span></div>
                  <div class="cm-row"><span class="cm-row__acct">personal</span><span class="cm-row__from">Marta Silva</span><span class="cm-row__age">1y</span><span class="cm-row__subj">Signed lease · lease-2026.pdf</span></div>
                </div>
                <div class="cm-srcline">source: icloud cache, personal cache, work cache</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="agents" aria-labelledby="agents-h">
    <div class="wrap">
      <div class="grid">
        <h2 id="agents-h" class="span-6">Your agent gets the same search</h2>
        <p class="span-6 start-7 t-lead">The MCP <code>search</code> tool takes the same queries. The index opens a thread in 14 ms, so your agent can read a dozen threads in one turn without waiting on a mail server. <a class="link" href="/docs/agents/working-with-mail">Read the agent guide</a></p>
      </div>
      <div class="frame fill cm-agentframe" role="img" aria-label="A Claude Code session. Asked which renewals still need an answer, the agent searches every account, opens three threads from the cache and lists the three that need you.">
        <div class="ui ui-panel cm-win" aria-hidden="true">
          <div class="cm-bar"><span class="ui-dots"><i></i><i></i><i></i></span><span class="cm-bar__title"><b>claude</b> · ~/mail</span><span class="ui-spacer"></span><span class="cm-tag">chainmail mcp</span></div>
          <div class="cm-term__body">
            <div class="cm-user"><span>&gt;</span><span>Which of my renewals still need an answer from me?</span></div>
            <div class="cm-step">
              <span class="cm-dot"></span>
              <div>
                <div class="cm-tool"><b>chainmail · search</b></div>
                <div class="cm-args">&#123; query: <s>"renewal newer_than:30d"</s>, threads: true &#125;</div>
                <div class="cm-res"><span><b>9 threads</b> · work, personal, icloud · source: cache</span></div>
              </div>
            </div>
            <div class="cm-step">
              <span class="cm-dot"></span>
              <div>
                <div class="cm-tool"><b>chainmail · get_thread</b> <i>× 3</i></div>
                <div class="cm-res"><span><b>Acme renewal</b>, <b>Lease renewal for the flat</b>, <b>Your domain renews on 1 December</b> · source: cache</span></div>
              </div>
            </div>
            <div class="cm-step cm-say">
              <span class="cm-dot cm-dot--say"></span>
              <p>Three need you. Dana Ortiz wants to know which day you'll sign the Acme renewal. Marta Silva needs an answer on the lease by Friday. Your domain renews on 1 December.</p>
            </div>
            <div class="cm-input"><span>&gt;</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section ground-surface" id="limits" aria-labelledby="limits-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-6 stack-5">
          <h2 id="limits-h">What the mail server still answers</h2>
          <p class="t-lead">The index holds the headers of all your mail and the bodies of the last 90 days, plus every message you have opened. It matches whole words, so <code>invoice</code> does not find <code>invoices</code>.</p>
          <ul class="cm-facts stack-2">
            <li>A word search with no date limit goes to the mail server, so it still finds older mail.</li>
            <li>Attachments always come from the server.</li>
          </ul>
          <p><a class="link" href="/docs/operations/cache">Read about the cache</a></p>
        </div>
        <div class="frame frame--split span-6 start-7 cm-statusframe" role="img" aria-label="chainmail cache status shows the work, personal and icloud accounts ready, with every folder backfilled and the bodies of the last 90 days cached.">
          <div class="stage stage--fade-b">
            <div class="at-corner to-edge" style="--ax:48px;--ay:56px;width:680px">
              <div class="ui ui-panel cm-win cm-frag" aria-hidden="true">
                <div class="cm-bar"><span class="ui-dots"><i></i><i></i><i></i></span><span class="cm-bar__title"><b>chainmail</b> · cache status</span></div>
                <div class="cm-cmd"><span class="p">$ </span>chainmail cache status --output table</div>
                <div class="cm-cstat">
                  <div class="sz">size &nbsp;1.4 GiB of 2.0 GiB</div>
                  <div class="h"><span>ACCOUNT</span><span>STATE</span><span>HEADERS</span><span>WINDOW</span></div>
                  <div><span>work</span><span class="ok">ready</span><span>256286</span><span>9120/9120 done</span></div>
                  <div><span>personal</span><span class="ok">ready</span><span>48731</span><span>2214/2214 done</span></div>
                  <div><span>icloud</span><span class="ok">ready</span><span>11902</span><span>388/388 done</span></div>
                  <div class="sp"></div>
                  <div class="h f"><span>ACCOUNT</span><span>FOLDER</span><span>STATE</span><span>BODIES</span></div>
                  <div class="f"><span>work</span><span>[Gmail]/All Mail</span><span class="ok">ready</span><span>9120</span></div>
                  <div class="f"><span>personal</span><span>INBOX</span><span class="ok">ready</span><span>1302</span></div>
                  <div class="f"><span>personal</span><span>Sent</span><span class="ok">ready</span><span>311</span></div>
                  <div class="f"><span>personal</span><span>Archive</span><span class="ok">ready</span><span>601</span></div>
                  <div class="f"><span>icloud</span><span>INBOX</span><span class="ok">ready</span><span>388</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="grid cm-figs" data-moment="counter-rolls">
        <div class="span-4"><p class="t-stat">32x</p><p class="t-small muted">faster for the newest 50 messages</p></div>
        <div class="span-4"><p class="t-stat">6 s</p><p class="t-small muted">from arrival to the index</p></div>
        <div class="span-4"><p class="t-stat">40 of 40</p><p class="t-small muted">live queries where the index and the servers agreed</p></div>
      </div>
    </div>
  </section>
</main>
</Base>
